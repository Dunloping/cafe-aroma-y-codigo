# Copiar a .env.local para desarrollo y configurar los mismos valores en Vercel.
# Neon / Supabase / Railway entregan una cadena lista para usar con sslmode=require.

DATABASE_URL="postgresql://usuario:password@host.neon.tech/neondb?sslmode=require"

# "disable" solo si el Postgres local no usa TLS. Cualquier otro valor fuerza SSL.
PGSSL="require"

# Sal aleatoria para hashear la IP de quien envía el formulario (nunca se guarda la IP).
IP_HASH_SALT="cambia-esta-cadena-por-una-aleatoria"
